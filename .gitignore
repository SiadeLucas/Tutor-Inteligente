# --- Segredos (NUNCA comitar) ---
.env
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
dist/
build/
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/

# --- Node.js / Next.js ---
node_modules/
.next/
out/
.turbo/

# --- Docker ---
postgres_data/
redis_data/

# --- IDE ---
.vscode/settings.json
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- MkDocs (site gerado) ---
site/
docs-site/site/
