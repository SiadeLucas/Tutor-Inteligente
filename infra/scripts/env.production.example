# ==============================================================================
# Tutor Inteligente — Variáveis de Ambiente de PRODUÇÃO (EC2)
# Copie para /home/ubuntu/tutor-inteligente/.env na instância:
#   cp infra/scripts/env.production.example .env && nano .env
#
# Gere segredos fortes com:  openssl rand -base64 32
# NUNCA comite o arquivo .env real no Git.
# ==============================================================================

# --- Banco de Dados PostgreSQL (containers internos) ---
DB_NAME=tutor_inteligente
DB_USER=tutor_admin
DB_PASSWORD=TROQUE_openssl_rand_base64_32
DB_HOST=database
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://tutor_admin:TROQUE_openssl_rand_base64_32@database:5432/tutor_inteligente

# --- Redis (containers internos) ---
REDIS_PASSWORD=TROQUE_openssl_rand_base64_32
REDIS_URL=redis://:TROQUE_openssl_rand_base64_32@redis:6379/0

# --- JWT e Segurança ---
JWT_SECRET_KEY=TROQUE_openssl_rand_base64_32
JWT_REFRESH_SECRET_KEY=TROQUE_outra_openssl_rand_base64_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Inteligência Artificial (Gemini Flash / Google) ---
GOOGLE_API_KEY=COLE_SUA_CHAVE_REAL_AQUI
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.1-flash-lite
EMBEDDING_MODEL_NAME=gemini-embedding-001

# --- Gateway de Pagamento (Asaas) ---
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET_TOKEN=
ASAAS_ENVIRONMENT=production

# --- AWS S3 (Armazenamento de Arquivos) — mesma conta da EC2, via IAM ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=tutor-inteligente-assets
AWS_REGION=sa-east-1

# --- Amazon SES (E-mail Transacional) ---
SES_SENDER_EMAIL=noreply@tutorinteligente.com.br

# --- Servidor ---
# Sem domínio: use http://SEU_IP_ELASTICO (nginx serve API e frontend na porta 80)
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=http://SEU_IP_ELASTICO
NEXT_PUBLIC_API_URL=http://SEU_IP_ELASTICO
